<Window x:Class="Desktop.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop"
        mc:Ignorable="d"
        Title="Registration" Height="450" Width="800">
    <Grid Margin="0,-16,0,0">
        <Image Margin="10,23,611,270" Source="/Image2.png" Stretch="Fill"/>
        <Label Content="Welcome back" HorizontalAlignment="Left" Height="46" Margin="517,34,0,0" FontSize="25"  VerticalAlignment="Top" Width="250"/>
        <Label Content="Имя пользователя" HorizontalAlignment="Left" Height="37" Margin="517,80,0,0" VerticalAlignment="Top" Width="157" FontSize="15"/>
        <TabControl HorizontalAlignment="Left" Height="4" Margin="517,126,0,0" VerticalAlignment="Top" Width="206"/>
        <Label Content="Введите имя пользователя" HorizontalAlignment="Left" Height="24" Margin="517,102,0,0" VerticalAlignment="Top" Width="160" Background="White" Foreground="#FF5D5A5A"/>
        <Label Content="Ваша почта" HorizontalAlignment="Left" Height="37" Margin="521,135,0,0" VerticalAlignment="Top" Width="156" FontSize="15"/>
        <TabControl HorizontalAlignment="Left" Height="4" Margin="517,172,0,0" VerticalAlignment="Top" Width="206"/>
        <Label Content="Пароль" HorizontalAlignment="Left" Height="37" Margin="519,181,0,0" VerticalAlignment="Top" Width="158" FontSize="15"/>
        <TabControl HorizontalAlignment="Left" Height="4" Margin="517,242,0,0" VerticalAlignment="Top" Width="206"/>
        <Label Content="Введите пароль" HorizontalAlignment="Left" Height="24" Margin="516,0,0,0" VerticalAlignment="Center" Width="157" Background="White" Foreground="#FF5D5A5A"/>
        <Label Content="Повторите пароль" HorizontalAlignment="Left" Height="37" Margin="516,251,0,0" VerticalAlignment="Top" Width="157" FontSize="15" RenderTransformOrigin="0.531,0.825"/>
        <Label Content="Повторите пароль" HorizontalAlignment="Left" Height="24" Margin="517,288,0,0" VerticalAlignment="Top" Width="157" Background="White" Foreground="#FF5D5A5A" RenderTransformOrigin="0.535,-0.116"/>
        <TabControl HorizontalAlignment="Left" Height="4" Margin="517,317,0,0" VerticalAlignment="Top" Width="206"/>
        <Button Content="Зарегистрироваться" HorizontalAlignment="Left" Margin="519,336,0,0" VerticalAlignment="Top" Height="40" Width="190"
            FontSize="18" Background="#FFF96060" Foreground="White" BorderBrush="#FFF96060" RenderTransformOrigin="0.504,0.658">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="10 10 3 3"/>
                </Style>
            </Button.Resources>
        </Button>
        <Button Content="Назад" HorizontalAlignment="Left" Margin="519,381,0,0" VerticalAlignment="Top" Height="40" Width="190"
            FontSize="18" Background="#FFF96060" Foreground="White" BorderBrush="#FFF96060" RenderTransformOrigin="0.504,0.658">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="3 3 10 10"/>
                </Style>
            </Button.Resources>
        </Button>

    </Grid>
</Window>
