<Page x:Class="Desktop.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop"
        mc:Ignorable="d"
        Title="Registration" Height="450" Width="800">
    <Grid Margin="0,-16,0,0">
        <Image Margin="10,23,611,270" Source="/Image2.png" Stretch="Fill"/>
        <Label Content="Welcome back" HorizontalAlignment="Left" Height="46" Margin="517,34,0,0" FontSize="25"  VerticalAlignment="Top" Width="250"/>
        <Label Content="Имя пользователя" HorizontalAlignment="Left" Height="37" Margin="517,80,0,0" VerticalAlignment="Top" Width="157" FontSize="15"/>
        <Label Content="Ваша почта" HorizontalAlignment="Left" Height="37" Margin="521,135,0,0" VerticalAlignment="Top" Width="156" FontSize="15"/>
        <Label Content="Пароль" HorizontalAlignment="Left" Height="33" Margin="524,188,0,0" VerticalAlignment="Top" Width="153" FontSize="15"/>
        <Label Content="Повторите пароль" HorizontalAlignment="Left" Height="37" Margin="516,251,0,0" VerticalAlignment="Top" Width="157" FontSize="15" RenderTransformOrigin="0.531,0.825"/>
        <Button x:Name="SubmitButton" Content="Зарегистрироваться" HorizontalAlignment="Left" Margin="519,336,0,0" VerticalAlignment="Top" Height="40" Width="190"
            FontSize="18" Background="#FFF96060" Foreground="White" BorderBrush="#FFF96060" RenderTransformOrigin="0.504,0.658" Click="SubmitButton_Click">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="10 10 3 3"/>
                </Style>
            </Button.Resources>
        </Button>
        <Button x:Name="CloseButton" Content="Назад" HorizontalAlignment="Left" Margin="519,381,0,0" VerticalAlignment="Top" Height="40" Width="190"
            FontSize="18" Background="#FFF96060" Foreground="White" BorderBrush="#FFF96060" RenderTransformOrigin="0.504,0.658" Click="CloseButton_Click">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="3 3 10 10"/>
                </Style>
            </Button.Resources>
        </Button>
        <Border BorderBrush="#FF959090" BorderThickness="1" Margin="521,138,105,311" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
        </Border>
        <Border BorderBrush="#FF959090" BorderThickness="1" Margin="526,181,103,268" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
        </Border>
        <Border BorderBrush="#FF959090" BorderThickness="1" Margin="523,234,105,214" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
        </Border>
        <Border BorderBrush="#FF959090" BorderThickness="1" Margin="524,299,105,149" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
        </Border>
        <TextBox x:Name="NameTextBox" HorizontalAlignment="Left" Margin="526,120,0,0" TextWrapping="Wrap" Text="Введите имя пользователя" VerticalAlignment="Top" Width="169" BorderBrush="White" Foreground="#FF959090"/>
        <TextBox x:Name="EmailTextBox" HorizontalAlignment="Left" Margin="527,163,0,0" TextWrapping="Wrap" Text="exam@yandex.ru" VerticalAlignment="Top" Width="162" BorderBrush="White" Foreground="#FF959090" TextChanged="TextBox_TextChanged"/>
        <TextBox x:Name="PasswordBox1" HorizontalAlignment="Left" Margin="527,0,0,0" TextWrapping="Wrap" Text="Введите пароль" VerticalAlignment="Center" Width="162" BorderBrush="White" Foreground="#FF959090"/>
        <TextBox x:Name="PasswordBox2" HorizontalAlignment="Left" Margin="523,281,0,0" TextWrapping="Wrap" Text="Повторите пароль" VerticalAlignment="Top" Width="172" BorderBrush="White" Foreground="#FF959090"/>

    </Grid>
</Page>
    
