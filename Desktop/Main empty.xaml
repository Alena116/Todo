<Window x:Class="Desktop.Main_empty"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop"
        mc:Ignorable="d"
        Title="Main_empty" Height="450" Width="800">
    <Grid>
        <Label Content="Добро пожаловать!" HorizontalAlignment="Left" Height="46" Margin="239,78,0,0" FontSize="25"  VerticalAlignment="Top" Width="250"/>
        <Label Content="Создайте свою первую &#xD;&#xA;задачу!" HorizontalAlignment="Left" Height="76" Margin="239,141,0,0" FontSize="25"  VerticalAlignment="Top" Width="384"/>
        <Button x:Name="CreateTaskButton" Content="Создать первую задачу" HorizontalAlignment="Center" Margin="0,298,0,0" VerticalAlignment="Top" Height="35" Width="212"
            FontSize="18" Background="#FFF96060" Foreground="White" BorderBrush="#FFF96060" RenderTransformOrigin="0.504,0.658">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="8 8 8 8"/>
                </Style>
            </Button.Resources>
        </Button>
        <Image x:Name="avatarImage" Margin="10,10,711,347" Source="/Image3.png" Stretch="Fill"/>
        <Button Content="Выход" HorizontalAlignment="Left" Height="24" Margin="5,100,0,0" VerticalAlignment="Top" Width="89" Click="Button_Click_2"/>
        <Button Content="Изменить фото профиля" HorizontalAlignment="Left" Height="37" Margin="5,129,0,0" VerticalAlignment="Top" Width="147" Click="Button_Click_1"/>

    </Grid>
</Window>
